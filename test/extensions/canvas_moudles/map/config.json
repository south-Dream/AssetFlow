{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "map",
  "name": "地图编辑",
  "desc": "可动态加载的地图示例，演示菜单、工具、Inspector、设置和画布间数据传递",
  "version": "1.0.0",
  "entry": "./index.js",
  "tools": [
    {
      "id": "map.paint",
      "name": "绘制地块",
      "command": "map.paint",
      "shortcut": "B",
      "kind": "tool",
      "fields": [
        {
          "id": "map.paint.size",
          "name": "地块尺寸",
          "type": "number",
          "default": 32,
          "min": 8,
          "max": 128,
          "renderer": "map.sizeDrawer",
          "order": 10
        },
        {
          "id": "map.paint.color",
          "name": "颜色",
          "type": "select",
          "default": "草地",
          "options": ["草地", "水面", "沙地"],
          "order": 20
        }
      ],
      "icon": "./icons/brush.svg",
      "desc": "在地图上绘制地块，在 Inspector 中调整尺寸与颜色。"
    },
    {
      "id": "map.clear",
      "name": "清空",
      "command": "map.clear",
      "shortcut": "Ctrl+Shift+S",
      "kind": "command",
      "toolbar": false
    }
  ],
  "menus": [
    {
      "id": "map.menu",
      "name": "地图",
      "placement": "specific",
      "children": [
        {
          "id": "map.menu.clear",
          "name": "清空地图",
          "command": "map.clear"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "map.grid",
      "name": "显示网格",
      "type": "boolean",
      "default": true
    }
  ],
  "inspector": {
    "canvas": [
      {
        "id": "map.gridSize",
        "name": "网格尺寸",
        "type": "number",
        "default": 32,
        "min": 8,
        "max": 128,
        "renderer": "map.sizeDrawer",
        "order": 10
      },
      {
        "id": "map.background",
        "name": "画布背景",
        "type": "select",
        "default": "深色",
        "options": ["深色", "浅色"],
        "order": 20
      },
      {
        "id": "map.clearButton",
        "name": "清空地图",
        "type": "boolean",
        "default": false,
        "control": "button",
        "command": "map.clear",
        "order": 30
      }
    ]
  }
}
