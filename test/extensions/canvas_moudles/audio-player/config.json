{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "audio-player",
  "name": "音频预览",
  "desc": "资源接口示例：音频播放器、波形和音轨",
  "version": "1.0.0",
  "entry": "./index.js",
  "resources": [
    {
      "extensions": ["mp3", "wav", "ogg", "flac", "m4a"],
      "handler": "audio-player.open",
      "mode": "replace",
      "maxCount": 1
    }
  ]
}
